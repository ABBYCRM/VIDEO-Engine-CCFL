# Generate with: openssl rand -hex 32
SANDBOX_TOKEN=

# Docker image commands run inside. node:20-alpine works for JS/TS repos.
# Use python:3.12-alpine, etc. for other stacks.
SANDBOX_IMAGE=node:20-alpine

# Leave false unless you specifically need package installs (npm/pip) inside
# the sandbox. Turning this on means sandboxed commands can reach the
# internet — a real exfiltration/abuse risk. Off by default on purpose.
SANDBOX_ALLOW_NETWORK=false

SANDBOX_MEMORY_MB=512
SANDBOX_CPUS=1
SANDBOX_COMMAND_TIMEOUT_MS=60000

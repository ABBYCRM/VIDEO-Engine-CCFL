+  setStatus(name, status) {
+    const n = String(name || '').trim();
+    const next = status === 'paused' ? 'paused' : 'active';
+    const row = this.get(n);
+    if (!row) return null;
+    this.db.prepare('UPDATE routines SET status = ?, updated_at = ? WHERE name = ?').run(next, Date.now(), n);
+    return this.get(n);
+  }
+
+  remove(name) {
+    const n = String(name || '').trim();
+    const row = this.get(n);
+    if (!row) return null;
+    this.db.prepare('DELETE FROM routines WHERE name = ?').run(n);
+    return { ok: true, deleted: n };
+  }
+
   close() { this.db.close(); }

diff --git a/test/routines_store.test.mjs b/test/routines_store.test.mjs
new file mode 100644
index 0000000..38594f4
--- /dev/null
+++ b/test/routines_store.test.mjs
@@ -0,0 +1,65 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { RoutineStore } from '../lib/routines.js';
+import { resolveBosGate } from '../lib/aion_kernel.js';
+import { BosOmegaRag } from '../lib/bos_omega_rag.js';
+
+test('RoutineStore persists list/upsert/pause/resume/delete in SQLite', () => {
+  const dir = mkdtempSync(join(tmpdir(), 'routines-'));
+  const store = new RoutineStore(join(dir, 'routines.sqlite'));
+  try {
+    const seeded = store.list();
+    assert.ok(seeded.length >= 1);
+    assert.equal(seeded.every((r) => r.status === 'active'), true);
+    const created = store.upsert({
+      name: 'nightly-ping',
+      trigger: 'every morning',
+      steps: [{ tool: 'datetime' }],
+      success: 'datetime ran',
+    });
+    assert.equal(created.name, 'nightly-ping');
+    assert.equal(created.status, 'active');
+    assert.equal(store.setStatus('nightly-ping', 'paused').status, 'paused');
+    assert.equal(store.setStatus('nightly-ping', 'active').status, 'active');
+    assert.equal(store.remove('nightly-ping').deleted, 'nightly-ping');
+    assert.equal(store.get('nightly-ping'), null);
+  } finally {
+    store.close();
+    rmSync(dir, { recursive: true, force: true });
+  }
+});
+
+test('appendOperatorMemory writes Continuity that retrieve can hit', () => {
+  const dir = mkdtempSync(join(tmpdir(), 'bos-write-'));
+  const rag = new BosOmegaRag({
+    dbPath: join(dir, 'bos-omega.sqlite'),
+    corpusDir: join(process.cwd(), 'knowledge', 'bos-omega'),
+  });
+  try {
+    rag.ensureIngested();
+    const before = rag.status().chunk_count;
+    const written = rag.appendOperatorMemory({
+      text: 'Operator Continuity note: unique-token-ZXQ-924 weldon follow-up lives in this write.',
+      title: 'operator-note',
+    });
+    assert.equal(written.ok, true);
+    assert.equal(rag.status().chunk_count > before, true);
+    const hit = rag.retrieve('unique-token-ZXQ-924');
+    assert.equal(hit.ok, true);
+    assert.ok(hit.chunks.some((c) => /unique-token-ZXQ-924/.test(c.text)));
+    assert.ok(hit.chunks.some((c) => c.authority === 'continuity'));
+  } finally {
+    rag.close();
+    rmSync(dir, { recursive: true, force: true });
+  }
+});
+
+test('resolveBosGate is Trinity GO/HOLD/ABORT', () => {
+  assert.equal(resolveBosGate('').state, 'ABORT');
+  assert.equal(resolveBosGate('Explain Trinity Alpha Omega').state, 'HOLD');
+  assert.equal(resolveBosGate('Explain Trinity Alpha Omega', { retrieved: true }).state, 'GO');
+  assert.equal(resolveBosGate('echo datetime').state, 'GO');
+});

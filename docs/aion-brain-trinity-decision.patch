index da4f1c7..7e59b0e 100644
--- a/lib/bos_omega_rag.js
+++ b/lib/bos_omega_rag.js
@@ -270,6 +270,49 @@ export class BosOmegaRag {
     return { ingested: true, chunk_count: rows.length, embedder: 'hash-sha256-256', files: files.length };
   }
 
+  /**
+   * Append an operator Continuity note without wiping Canon/Patch corpus.
+   * Durable SQLite write — same store GET /api/memory/bos retrieves from.
+   */
+  appendOperatorMemory({ text, title = 'operator-note' } = {}) {
+    const body = String(text || '').trim();
+    if (!body) return { ok: false, error: 'text_required', chunk_count: 0 };
+    this.ensureIngested();
+    const sourceId = `operator-${Date.now()}`;
+    const titleSafe = String(title || 'operator-note').slice(0, 80);
+    const chunks = chunkDocument({
+      sourceId,
+      title: titleSafe,
+      content: body,
+      chunkSize: this.chunkSize,
+      overlap: this.overlap,
+    });
+    const insert = this.db.prepare(`
+      INSERT OR REPLACE INTO chunks (
+        chunk_id, source_id, title, text, authority, ordinal, file_mtime,
+        vector_json, vector_dim, embedder
+      ) VALUES (
+        @chunk_id, @source_id, @title, @text, @authority, @ordinal, @file_mtime,
+        @vector_json, @vector_dim, @embedder
+      )
+    `);
+    const tx = this.db.transaction((batch) => {
+      for (const chunk of batch) {
+        const vector = hashEmbed(`${chunk.source_id} ${chunk.title} ${chunk.text}`);
+        insert.run({
+          ...chunk,
+          authority: 'continuity',
+          file_mtime: Date.now(),
+          vector_json: JSON.stringify(vector),
+          vector_dim: vector.length,
+          embedder: 'hash-sha256-256',
+        });
+      }
+    });
+    tx(chunks);
+    return { ok: true, source_id: sourceId, authority: 'continuity', chunk_count: chunks.length, persist: 'bos-omega.sqlite' };
+  }
+
   retrieve(query, { topK = 6, minScore = 0.02 } = {}) {
     const q = String(query || '').trim();
     if (!q) return { ok: false, error: 'query_required', chunks: [] };

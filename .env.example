# Never commit real secrets.
ADMIN_PASSWORD=change-me
SESSION_SECRET=replace-with-32-plus-random-characters
# Generate with: npm run token:key
APP_ENCRYPTION_KEY=BASE64_32_BYTE_KEY

# Optional fallback. Prefer saving the Gemini key in Settings after login.
GEMINI_API_KEY=

# Claw's low-latency NVIDIA NIM chat model.
CLAW_NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# SQLite database and generated video storage.
DATABASE_PATH=./data/video-engine.db
VIDEO_OUTPUT_DIR=./data/videos

# Public base URL, used in API responses when deployed.
PUBLIC_BASE_URL=http://localhost:3000

# Steel.dev browser access for Claw public-web research.
STEEL_API_KEY=
# Optional for a self-hosted Steel API. Defaults to https://api.steel.dev.
STEEL_BASE_URL=

# Instagram Graph (adelaidasofia/instagram-mcp). Prefer saving these on Integrations.
# Long-lived token with instagram_basic + instagram_content_publish + instagram_manage_comments + instagram_manage_insights.
INSTAGRAM_MCP_ACCESS_TOKEN=
INSTAGRAM_MCP_IG_USER_ID=
# Optional. Signs every Graph call with appsecret_proof.
INSTAGRAM_MCP_APP_SECRET=
# graph.facebook.com (default) or graph.instagram.com
INSTAGRAM_MCP_BASE_HOST=graph.facebook.com
# Graph API version (default v21.0).
INSTAGRAM_MCP_GRAPH_VERSION=v21.0
# Set to 1 after Meta App Review grants instagram_manage_messages (Claw DMs).
INSTAGRAM_MCP_DM_ENABLED=0

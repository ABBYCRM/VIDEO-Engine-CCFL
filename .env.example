# Never commit real secrets.
ADMIN_PASSWORD=change-me
SESSION_SECRET=replace-with-32-plus-random-characters
# Generate with: npm run token:key
APP_ENCRYPTION_KEY=BASE64_32_BYTE_KEY

# Optional fallback. Prefer saving the Gemini key in Settings after login.
GEMINI_API_KEY=

# Claw's low-latency NVIDIA NIM chat model.
CLAW_NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Hard cap on real-money generation calls (generate_video, generate_still,
# ugc_batch_generate, generate_blog_post) Claw will auto-run per UTC day,
# across every conversation. Going over requires an explicit CONFIRM reply
# from the operator, same as any other AION-gated tool. Defaults to 15.
CLAW_DAILY_GENERATION_LIMIT=15

# SQLite database and generated video storage.
DATABASE_PATH=./data/video-engine.db
VIDEO_OUTPUT_DIR=./data/videos

# Public base URL, used in API responses when deployed.
PUBLIC_BASE_URL=http://localhost:3000

# Steel.dev browser access for Claw public-web research (steel_scrape, primary provider).
STEEL_API_KEY=
# Optional for a self-hosted Steel API. Defaults to https://api.steel.dev.
STEEL_BASE_URL=

# steel_scrape fallback chain, tried in order if Steel fails or isn't configured.
FIRECRAWL_API_KEY=
SCRAPINGBEE_API_KEY=
SCRAPFLY_API_KEY=

# web_screenshot tool (screenshotone.com). Secret key is optional (used to
# HMAC-sign requests); access key alone is enough to make calls.
SCREENSHOTONE_ACCESS_KEY=
SCREENSHOTONE_SECRET_KEY=

# web_search tool. Exa is tried first, Tavily is the fallback.
EXA_API_KEY=
TAVILY_API_KEY=

# Composio (primary Instagram path and connector for other supported apps).
COMPOSIO_API_KEY=

# Optional Helicone (helicone.ai) LLM observability proxy in front of NVIDIA
# NIM calls. Requires an explicit opt-in beyond just the key — see
# lib/nvidia/helicone.ts for why (unapproved custom-provider rate limit).
HELICONE_API_KEY=
HELICONE_ENABLED=

# Optional E2B (e2b.dev) hosted sandbox as the Coding Agent backend, in
# place of an operator-provisioned CODING_SANDBOX_URL. Set
# CODING_SANDBOX_PROVIDER=e2b to switch to it once E2B_API_KEY is set.
E2B_API_KEY=
CODING_SANDBOX_PROVIDER=

# Instagram Graph (adelaidasofia/instagram-mcp). Prefer saving these on Integrations.
# Long-lived token with instagram_basic + instagram_content_publish + instagram_manage_comments + instagram_manage_insights.
INSTAGRAM_MCP_ACCESS_TOKEN=
INSTAGRAM_MCP_IG_USER_ID=
# Optional. Signs every Graph call with appsecret_proof.
INSTAGRAM_MCP_APP_SECRET=
# graph.facebook.com (default) or graph.instagram.com
INSTAGRAM_MCP_BASE_HOST=graph.facebook.com
# Graph API version (default v21.0).
INSTAGRAM_MCP_GRAPH_VERSION=v21.0
# Enables Claw DMs on the direct Graph fallback after Meta App Review grants
# instagram_manage_messages. Composio DM availability uses its own OAuth scopes.
INSTAGRAM_MCP_DM_ENABLED=0

# Coding Agent: a SEPARATE, network-isolated sandbox service the operator
# provisions — this app never executes code in its own process. Leave unset
# to keep the Coding Agent tools disabled. See lib/coding-agent/client.ts.
CODING_SANDBOX_URL=
CODING_SANDBOX_TOKEN=

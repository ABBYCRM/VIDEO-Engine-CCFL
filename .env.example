# Never commit real secrets. Names only — coordinator injects DigitalOcean values.
# ADMIN_PASSWORD: known smell (plaintext compare + unused while requireAdmin() is open). Do not hardcode a new secret.
ADMIN_PASSWORD=change-me
SESSION_SECRET=replace-with-32-plus-random-characters
APP_ENCRYPTION_KEY=BASE64_32_BYTE_KEY
# UNUSED in this Claw-only tree (no Veo client): GEMINI_API_KEY
GEMINI_API_KEY=

# Claw Bitdeer inference. Do NOT set OPENAI_API_KEY.
CLAW_NVIDIA_MODEL=mistralai/Mistral-Large-3-675B-Instruct-2512
BITDEER_TEXT_MODEL=mistralai/Mistral-Large-3-675B-Instruct-2512
BITDEER_IMAGE_MODEL=black-forest-labs/FLUX-2-pro
CLAW_RERANK_MODEL=BAAI/bge-reranker-v2-m3
BITDEER_RERANK_MODEL=BAAI/bge-reranker-v2-m3
CLAW_ENABLED=true
CLAW_DAILY_GENERATION_LIMIT=15
# UNUSED (reddit-research/ and sites were stripped): REDDIT_AUTOPILOT_ENABLED, SITE_AUTOPILOT_ENABLED
REDDIT_AUTOPILOT_ENABLED=true
SITE_AUTOPILOT_ENABLED=true
# UNUSED — SQLite path is hardcoded to data/claw.db
DATABASE_PATH=./data/video-engine.db
# UNUSED in this Claw-only tree
VIDEO_OUTPUT_DIR=./data/videos
PUBLIC_BASE_URL=http://localhost:3000
IMAGE_GEN_ENABLED=true
FORGE_MAX_SESSIONS=2

STEEL_API_KEY=
STEEL_BASE_URL=

# Claw Computer (local Playwright or DigitalOcean worker). Token is orchestrator-only.
DIGITALOCEAN_TOKEN=
DIGITALOCEAN_REGION=nyc3
DIGITALOCEAN_VPC_UUID=
DIGITALOCEAN_BROWSER_SNAPSHOT_ID=
DIGITALOCEAN_BROWSER_SIZE=s-2vcpu-4gb
# UNUSED — Computer uses in-process Playwright; no remote worker client reads this.
COMPUTER_WORKER_URL=

FIRECRAWL_API_KEY=
SCRAPINGBEE_API_KEY=
SCRAPFLY_API_KEY=
SCREENSHOTONE_ACCESS_KEY=
SCREENSHOTONE_SECRET_KEY=
EXA_API_KEY=
TAVILY_API_KEY=
COMPOSIO_API_KEY=
HELICONE_API_KEY=
HELICONE_ENABLED=
E2B_API_KEY=
CODING_SANDBOX_PROVIDER=
HEDRA_API_KEY=
RESEND_API_KEY=
RESEND_FROM=
GITHUB_PERSONAL_ACCESS_TOKEN=
INSTAGRAM_MCP_ACCESS_TOKEN=
INSTAGRAM_MCP_IG_USER_ID=
INSTAGRAM_MCP_APP_SECRET=
INSTAGRAM_MCP_BASE_HOST=graph.facebook.com
INSTAGRAM_MCP_GRAPH_VERSION=v21.0
INSTAGRAM_MCP_DM_ENABLED=0
# Documented for sandbox-server; main app has no coding-agent client yet (e2b_run is the live shell).
CODING_SANDBOX_URL=
CODING_SANDBOX_TOKEN=

# Bitdeer AI (chat + rerank + embeddings + image). NVIDIA_* names are aliases.
# Do NOT set OPENAI_API_KEY.
BITDEER_API_KEY=
BITDEER_API_KEYS=
BITDEER_BASE_URL=https://api-inference.bitdeer.ai/v1
NVIDIA_API_KEY=
NVIDIA_API_KEYS=
NVIDIA_BASE_URL=https://api-inference.bitdeer.ai/v1
EMBEDDINGS_API_KEY=
LANGCHAIN_API_KEY=
PINECONE_API_KEY=
INNGEST_EVENT_KEY=
# UNUSED in this Claw-only tree (no A2E / xAI / Pinecone / Inngest / LangChain clients).
A2E_API_KEY=

DATABASE_URL=
VECTOR_DATABASE_URL=
CLAW_EMBED_MODEL=nvidia/Nemotron-3-Embed-1B-BF16
BITDEER_EMBED_MODEL=nvidia/Nemotron-3-Embed-1B-BF16
AION_BASE_URL=
AION_API_KEY=
# Cursor Cloud Agents (server-only). Name only — never commit the value.
# DigitalOcean already injects this SECRET for the live app.
CURSOR_API_KEY=

# Never commit real secrets.
ADMIN_PASSWORD=change-me
SESSION_SECRET=replace-with-32-plus-random-characters
APP_ENCRYPTION_KEY=BASE64_32_BYTE_KEY
GEMINI_API_KEY=

# Claw NVIDIA NIM. Do NOT set OPENAI_API_KEY.
CLAW_NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
CLAW_RERANK_MODEL=nvidia/llama-3.2-nv-rerankqa-1b-v2
CLAW_DAILY_GENERATION_LIMIT=15
REDDIT_AUTOPILOT_ENABLED=true
SITE_AUTOPILOT_ENABLED=true
DATABASE_PATH=./data/video-engine.db
VIDEO_OUTPUT_DIR=./data/videos
PUBLIC_BASE_URL=http://localhost:3000

STEEL_API_KEY=
